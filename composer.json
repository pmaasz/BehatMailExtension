{
  "name": "pmaasz/behat-mail-extension",
  "description": "An extension for testing emails with Behat",
  "license": "MIT",
  "authors": [
    {
      "name": "Philip Maaß",
      "email": "PhilipMaasz@aol.com"
    }
  ],
  "require": {
    "php" : ">=8.3",
    "guzzlehttp/guzzle": "^7.15",
    "behat/behat": "^3.0",
    "ext-json": "*",
    "ext-imap": "*",
    "ddeboer/imap": "^1.19"
  },
  "require-dev": {
    "phpspec/phpspec": "^8.0",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "BehatMailExtension\\": "src/"
    }
  },
  "minimum-stability": "stable"
}
